NODE_ENV=development
HOST=0.0.0.0
PORT=3000
FRONTEND_PORT=5173
PUBLIC_API_URL=http://localhost:3000
FRONTEND_API_URL=http://localhost:3000/api
LOG_LEVEL=INFO

# Use a comma-separated list for multiple browser origins.
CORS_ORIGIN=http://localhost:5173

# Docker MongoDB settings. Compose provides the internal service URI to the backend.
MONGODB_URI=mongodb://mongo:27017/chronos
MONGODB_DATABASE=chronos
MONGODB_HOST_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_ROOT_USERNAME=chronos_root
MONGODB_ROOT_PASSWORD=replace_with_a_unique_mongodb_password
DATABASE_AUTO_INITIALIZE=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_RETRY_DELAY_MS=5000
MONGODB_MAX_POOL_SIZE=10

# Server-only secrets. Generate unique production values; never commit .env.
JWT_SECRET=replace_with_a_unique_long_random_jwt_secret
EXTERNAL_SERVICE_CLIENT_ID=
EXTERNAL_SERVICE_CLIENT_SECRET=
